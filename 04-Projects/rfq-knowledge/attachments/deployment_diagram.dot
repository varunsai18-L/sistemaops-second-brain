digraph "Deployment Architecture" {
  graph [
    label="Deployment Architecture"
    labelloc="t"
    labeljust="c"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=20
    fontcolor="#0f172a"
    bgcolor="white"
    rankdir=TB
    ranksep=1.2
    nodesep=0.6
    splines=ortho
    pad=0.8
    compound=true
  ]
  node [
    shape=roundedbox
    style="filled,rounded"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    margin="0.2,0.12"
    penwidth=1.8
  ]
  edge [
    color="#94a3b8"
    penwidth=1.5
    arrowsize=0.8
    arrowhead=vee
  ]

  subgraph cluster_frontend {
    label="🖥 Frontend"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#3b82f6"
    style="rounded,dashed"
    color="#3b82f6"
    bgcolor="#dbeafe22"
    margin=16

    waf [label="Web Application Firewall (WAF)" fillcolor="#dbeafe" color="#3b82f6" fontcolor="#1e40af"]
  }

  subgraph cluster_gateway {
    label="⚡ Gateway"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#0284c7"
    style="rounded,dashed"
    color="#0284c7"
    bgcolor="#e0f2fe22"
    margin=16

    cloudfront_cdn [label="CloudFront CDN" fillcolor="#e0f2fe" color="#0284c7" fontcolor="#0c4a6e"]
    application_load_balancer [label="Application Load Balancer" fillcolor="#e0f2fe" color="#0284c7" fontcolor="#0c4a6e"]
  }

  subgraph cluster_queue {
    label="📨 Message Queue"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#65a30d"
    style="rounded,dashed"
    color="#65a30d"
    bgcolor="#ecfccb22"
    margin=16

    msk_rabbitmq [label="MSK RabbitMQ Message Queue" fillcolor="#ecfccb" color="#65a30d" fontcolor="#1a2e05"]
  }

  subgraph cluster_data {
    label="🗄 Data"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#10b981"
    style="rounded,dashed"
    color="#10b981"
    bgcolor="#d1fae522"
    margin=16

    rds_postgresql [label="RDS PostgreSQL Database" fillcolor="#d1fae5" color="#10b981" fontcolor="#064e3b"]
    mongodb_atlas [label="MongoDB Atlas Database" fillcolor="#d1fae5" color="#10b981" fontcolor="#064e3b"]
    s3 [label="S3 Object Storage" fillcolor="#d1fae5" color="#10b981" fontcolor="#064e3b"]
  }

  subgraph cluster_cache {
    label="💾 Cache"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#ca8a04"
    style="rounded,dashed"
    color="#ca8a04"
    bgcolor="#fefce822"
    margin=16

    elasti_cache_redis [label="ElastiCache Redis Cache" fillcolor="#fefce8" color="#ca8a04" fontcolor="#422006"]
  }

  subgraph cluster_search {
    label="🔍 Search"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#6d28d9"
    style="rounded,dashed"
    color="#6d28d9"
    bgcolor="#f5f3ff22"
    margin=16

    elasticsearch [label="ElasticSearch Search Engine" fillcolor="#f5f3ff" color="#6d28d9" fontcolor="#2e1065"]
  }

  subgraph cluster_infrastructure {
    label="☁️ Infrastructure"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#64748b"
    style="rounded,dashed"
    color="#64748b"
    bgcolor="#f1f5f922"
    margin=16

    internet [label="Internet" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
    route53 [label="Route53" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
    eks_cluster [label="EKS Cluster" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
    node_groups [label="Node Groups" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
    ecr [label="ECR (Container Registry)" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
    github_actions_ci_cd [label="GitHub Actions CI/CD" fillcolor="#f1f5f9" color="#64748b" fontcolor="#1e293b"]
  }

  subgraph cluster_monitoring {
    label="📊 Monitoring"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#be123c"
    style="rounded,dashed"
    color="#be123c"
    bgcolor="#fff1f222"
    margin=16

    cloudwatch [label="CloudWatch Monitoring" fillcolor="#fff1f2" color="#be123c" fontcolor="#4c0519"]
  }

  // Connections
  internet -> route53
  route53 -> cloudfront_cdn
  cloudfront_cdn -> waf
  waf -> application_load_balancer
  application_load_balancer -> eks_cluster
  eks_cluster -> node_groups
  github_actions_ci_cd -> ecr
  ecr -> eks_cluster
  eks_cluster -> rds_postgresql
  eks_cluster -> mongodb_atlas
  eks_cluster -> elasti_cache_redis
  eks_cluster -> msk_rabbitmq
  eks_cluster -> elasticsearch
  eks_cluster -> s3
  cloudwatch -> eks_cluster
  cloudwatch -> rds_postgresql
  cloudwatch -> mongodb_atlas
  cloudwatch -> elasti_cache_redis
  cloudwatch -> msk_rabbitmq
  cloudwatch -> elasticsearch
}