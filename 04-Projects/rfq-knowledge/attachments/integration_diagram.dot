digraph "Integration Architecture" {
  graph [
    label="Integration Architecture"
    labelloc="t"
    labeljust="c"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=20
    fontcolor="#0f172a"
    bgcolor="white"
    rankdir=LR
    ranksep=1.2
    nodesep=0.6
    splines=ortho
    pad=0.8
    compound=true
  ]
  node [
    shape=roundedbox
    style="filled,rounded"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    margin="0.2,0.12"
    penwidth=1.8
  ]
  edge [
    color="#94a3b8"
    penwidth=1.5
    arrowsize=0.8
    arrowhead=vee
  ]

  subgraph cluster_gateway {
    label="⚡ Gateway"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#0284c7"
    style="rounded,dashed"
    color="#0284c7"
    bgcolor="#e0f2fe22"
    margin=16

    api_gateway [label="API Gateway" fillcolor="#e0f2fe" color="#0284c7" fontcolor="#0c4a6e"]
    sms_gateway [label="SMS Gateway" fillcolor="#e0f2fe" color="#0284c7" fontcolor="#0c4a6e"]
    payment_gateway [label="Payment Gateway" fillcolor="#e0f2fe" color="#0284c7" fontcolor="#0c4a6e"]
  }

  subgraph cluster_security {
    label="🛡 Security"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#db2777"
    style="rounded,dashed"
    color="#db2777"
    bgcolor="#fce7f322"
    margin=16

    identity_provider [label="Identity Provider" fillcolor="#fce7f3" color="#db2777" fontcolor="#831843"]
  }

  subgraph cluster_queue {
    label="📨 Message Queue"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#65a30d"
    style="rounded,dashed"
    color="#65a30d"
    bgcolor="#ecfccb22"
    margin=16

    message_queue [label="Message Queue" fillcolor="#ecfccb" color="#65a30d" fontcolor="#1a2e05"]
  }

  subgraph cluster_data {
    label="🗄 Data"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#10b981"
    style="rounded,dashed"
    color="#10b981"
    bgcolor="#d1fae522"
    margin=16

    document_storage [label="Document Storage" fillcolor="#d1fae5" color="#10b981" fontcolor="#064e3b"]
  }

  subgraph cluster_integration {
    label="🔗 Integration"
    fontname="Helvetica Neue, Arial, sans-serif"
    fontsize=13
    fontcolor="#f59e0b"
    style="rounded,dashed"
    color="#f59e0b"
    bgcolor="#fef3c722"
    margin=16

    integration_layer [label="Integration Layer" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    hr_management_system [label="HR Management System" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    payroll_system [label="Payroll System" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    crm_platform [label="CRM Platform" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    erp_platform [label="ERP Platform" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    email_service [label="Email Service" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    video_conferencing [label="Video Conferencing" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    notification_service [label="Notification Service" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
    analytics_platform [label="Analytics Platform" fillcolor="#fef3c7" color="#f59e0b" fontcolor="#78350f"]
  }

  // Connections
  api_gateway -> integration_layer
  integration_layer -> hr_management_system
  integration_layer -> payroll_system
  integration_layer -> crm_platform
  integration_layer -> erp_platform
  hr_management_system -> message_queue
  payroll_system -> message_queue
  crm_platform -> message_queue
  erp_platform -> message_queue
  api_gateway -> identity_provider
  identity_provider -> api_gateway
  integration_layer -> email_service
  integration_layer -> sms_gateway
  integration_layer -> payment_gateway
  integration_layer -> document_storage
  video_conferencing -> message_queue
  notification_service -> message_queue
  analytics_platform -> message_queue
}